{
  "openapi": "3.0.1",
  "info": {
    "title": "Enum Special Characters Test API",
    "version": "v1"
  },
  "paths": {
    "/api/version": {
      "get": {
        "tags": ["Version"],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "post": {
        "tags": ["Config"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VersionResponse": {
        "type": "object",
        "properties": {
          "version": {
            "$ref": "#/components/schemas/VersionEnum"
          },
          "protocol": {
            "$ref": "#/components/schemas/ProtocolEnum"
          },
          "status": {
            "$ref": "#/components/schemas/StatusCodeEnum"
          }
        }
      },
      "ConfigRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/ModeEnum"
          }
        }
      },
      "ConfigResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "VersionEnum": {
        "type": "string",
        "description": "Version with dots",
        "enum": [
          "EET1.0",
          "EET2.0",
          "EET3.0",
          "v4.5.6"
        ]
      },
      "ProtocolEnum": {
        "type": "string",
        "description": "Protocol with hyphens and dots",
        "enum": [
          "HTTP/1.1",
          "HTTP/2.0",
          "TLS-1.2",
          "TLS-1.3"
        ]
      },
      "StatusCodeEnum": {
        "type": "integer",
        "description": "Integer enum that starts with numbers",
        "enum": [
          -1,
          200,
          201,
          400,
          404,
          500
        ]
      },
      "ModeEnum": {
        "type": "string",
        "description": "Mode with spaces and special characters",
        "enum": [
          "Debug Mode",
          "Production-Mode",
          "Test@Environment",
          "Staging_Mode",
          "Dev (Local)"
        ]
      }
    }
  }
}

